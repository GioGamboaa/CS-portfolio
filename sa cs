class Account :
    def __init__ (self, acc_num, acc_name, acc_balance):
    
        self.__acc_balance = acc_balance
        self.acc_name = acc_name
        self.acc_num = acc_num
        
    def getbalance():
        return self.__acc_balance
        
    def deposit(amount):
        if 0<amount:
            self.__acc_balance += amount
            
        else: 
            print("invalid")
            
    def withdraw(amount):
        if 0<amount<self.__acc_balance:
            print(f"you withdrew {amount} from your balance")
            
        else:
            print("invalid")
            
    def __str__():
        return f"{self.acc_name}"
        return f"[{self.acc_num}]"
        return f"P {self.__acc_balance}"
        
            
    def __del__(self):
        print(f"[{self.acc_num}] is closed")
        
class Saving_Acc(Account):
    
    def __init__ (self, acc_num, acc_name, acc_balance, interest_rate):
        super().__init__()
        self.__interest= interest_rate
        
    def interest ():
        self.__acc_balance += self.__acc_balance* (self.__interest / 100) 
        
